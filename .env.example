# Public server-side URL of the Directus instance used by Next.js.
DIRECTUS_URL=http://localhost:8055

# Local Directus bootstrap values. Replace all three before first startup.
DIRECTUS_SECRET=replace-with-a-long-random-value
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-strong-password
DIRECTUS_PUBLIC_URL=http://localhost:8055
SITE_URL=http://localhost:3000
