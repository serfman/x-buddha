# Copy to .env.production on the VPS, keep mode 600, and replace every required value.

# Public Next.js configuration. NEXT_PUBLIC_* values are embedded during image build.
SITE_URL=https://x-buddha.ru
DIRECTUS_URL=https://admin.x-buddha.ru
DIRECTUS_INTERNAL_URL=http://directus:8055
NEXT_PUBLIC_ADMIN_URL=https://admin.x-buddha.ru
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Directus production configuration. Generate independent values, for example: openssl rand -hex 32
DIRECTUS_KEY=replace-with-an-independent-random-key
DIRECTUS_SECRET=replace-with-an-independent-random-secret
DIRECTUS_ADMIN_EMAIL=replace-with-production-admin-email
DIRECTUS_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# PostgreSQL credentials used only on the private Docker network.
POSTGRES_DB=replace-with-database-name
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-a-strong-unique-database-password
